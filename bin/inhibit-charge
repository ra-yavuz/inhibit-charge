#!/usr/bin/env bash
# inhibit-charge: switch laptop battery between "home" (park at target%) and
# "travel" (charge to 100). User-facing CLI for the inhibit-charge package.
set -euo pipefail

STATE_DIR=/var/lib/inhibit-charge
SERVICE=inhibit-charged.service
LIBDIR=/usr/lib/inhibit-charge

# Auto-detect the first BAT* and first AC-like supply. Falls back to BAT0/AC.
detect_supplies() {
    local d type
    BAT=""
    AC=""
    for d in /sys/class/power_supply/*; do
        [ -r "$d/type" ] || continue
        type=$(cat "$d/type" 2>/dev/null || echo "")
        case "$type" in
            Battery) [ -z "$BAT" ] && BAT=$d ;;
            Mains|USB|USB_PD|USB_PD_DRP|USB_C|ACAD) [ -z "$AC" ] && AC=$d ;;
        esac
    done
    [ -n "$BAT" ] || BAT=/sys/class/power_supply/BAT0
    [ -n "$AC" ]  || AC=/sys/class/power_supply/AC
}

usage() {
    cat <<EOF
Usage: inhibit-charge <command>

Commands:
  home [TARGET]    Park battery at TARGET% (default 60). Holds the battery
                   there indefinitely on AC using inhibit-charge.
  travel           Charge fully to 100% for unplugged use.
  toggle           Flip between home and travel.
  status           Show current mode, battery %, AC status, behaviour.
  check            Check whether this hardware can run inhibit-charge.
                   Run this first if you are not sure the tool will help
                   on your laptop.
  motd [on|off]    Toggle the greeting shown at the top of every new
                   interactive shell. With no argument, toggle. With
                   "status", just report.

Hardware support:
  Requires Linux kernel >= 5.17 and a battery driver that exposes
  /sys/class/power_supply/BAT*/charge_behaviour with 'inhibit-charge'
  listed (mostly ThinkPad, Chromebook, Framework, System76, some Asus).
  Run 'inhibit-charge check' to verify. If your hardware is not
  supported, this tool cannot help; use TLP for start/end thresholds.

Examples:
  inhibit-charge check       # is this tool useful on this laptop?
  inhibit-charge home        # park at 60% (default)
  inhibit-charge home 70     # park at 70%
  inhibit-charge travel      # before going out
  inhibit-charge motd        # toggle terminal greeting on/off

DISCLAIMER: This tool writes to your laptop's battery management
interface. It is provided AS IS, WITHOUT WARRANTY OF ANY KIND. You are
solely responsible for any damage to your battery, hardware, or data.
The author is not liable for damage caused by events outside their
control (supply-chain compromise, modifications made downstream, etc).
See /usr/share/doc/inhibit-charge/README.md for the full disclaimer.
EOF
}

# The greeting is implemented via /etc/profile.d/50-inhibit-charge.sh,
# which login shells source on their own. Most desktop terminal tabs,
# however, are interactive NON-login shells (sourced via
# /etc/bash.bashrc, which on Ubuntu does NOT source profile.d). So
# enabling the greeting *also* drops a one-line source instruction into
# the invoking user's ~/.bashrc, guarded by clear marker comments so
# the CLI can remove it cleanly later.
MOTD_FLAG=/var/lib/inhibit-charge/motd-enabled
PROFILE_FILE=/etc/profile.d/50-inhibit-charge.sh
# shellcheck disable=SC2016 # markers are intentionally literal, not expanded
BASHRC_BEGIN_MARKER='# >>> inhibit-charge greeting (managed by `inhibit-charge motd`) >>>'
BASHRC_END_MARKER='# <<< inhibit-charge greeting <<<'

motd_enabled() {
    [ -f "$MOTD_FLAG" ]
}

motd_require_writable() {
    if [ "$(id -u)" -eq 0 ]; then
        return 0
    fi
    if [ -w "$STATE_DIR" ]; then
        return 0
    fi
    if id -nG | tr ' ' '\n' | grep -qx inhibit-charge; then
        echo "Error: cannot write to $STATE_DIR even though you are in the" >&2
        echo "inhibit-charge group. Check the directory's group-writable bit:" >&2
        echo "  ls -ld $STATE_DIR    (expected: drwxrwxr-x root inhibit-charge)" >&2
        echo "If it is wrong, run: sudo chmod 0775 $STATE_DIR && sudo chgrp inhibit-charge $STATE_DIR" >&2
    elif getent group inhibit-charge >/dev/null 2>&1; then
        echo "Error: cannot write to $STATE_DIR because your current shell" >&2
        echo "session does not yet have the 'inhibit-charge' group active." >&2
        echo "Linux freezes group lists at login. Pick one:" >&2
        echo "  newgrp inhibit-charge   (works in this terminal)" >&2
        echo "  log out and back in / reboot" >&2
    else
        echo "Error: cannot write to $STATE_DIR. The 'inhibit-charge'" >&2
        echo "group does not exist. Reinstall the package, or:" >&2
        echo "  sudo addgroup --system inhibit-charge" >&2
        echo "  sudo chgrp inhibit-charge $STATE_DIR && sudo chmod 0775 $STATE_DIR" >&2
        echo "  sudo usermod -aG inhibit-charge \$USER" >&2
    fi
    exit 1
}

# The home directory of the *invoking* user (not root, even when run
# under sudo). We patch their ~/.bashrc, not root's.
target_home() {
    local who=${SUDO_USER:-${USER:-$(id -un)}}
    getent passwd "$who" | cut -d: -f6
}

bashrc_path() {
    local home
    home=$(target_home)
    [ -n "$home" ] || { echo ""; return; }
    echo "$home/.bashrc"
}

bashrc_block_present() {
    local rc
    rc=$(bashrc_path)
    [ -n "$rc" ] && [ -f "$rc" ] && grep -qF "$BASHRC_BEGIN_MARKER" "$rc"
}

# Add the source-snippet block to ~/.bashrc if not already there.
# Idempotent. Owned by the invoking user, not root.
bashrc_block_add() {
    local rc
    rc=$(bashrc_path)
    [ -n "$rc" ] || return 0
    [ -f "$rc" ] || touch "$rc"
    if bashrc_block_present; then
        return 0
    fi
    {
        echo ""
        echo "$BASHRC_BEGIN_MARKER"
        echo "# This block is added by 'inhibit-charge motd' and removed by"
        echo "# 'inhibit-charge motd off'. Do not edit by hand."
        echo "if [ -r /etc/profile.d/50-inhibit-charge.sh ]; then"
        echo "    . /etc/profile.d/50-inhibit-charge.sh"
        echo "fi"
        echo "$BASHRC_END_MARKER"
    } >> "$rc"
    # Make sure ownership stays with the user (sudo invocations can
    # otherwise create root-owned content via redirected appends. Here
    # we appended through a shell that inherits the user's identity in
    # most cases, but when run via sudo this is necessary).
    if [ "$(id -u)" -eq 0 ]; then
        local who=${SUDO_USER:-}
        if [ -n "$who" ] && [ "$who" != "root" ]; then
            chown "$who":"$(id -gn "$who")" "$rc" 2>/dev/null || true
        fi
    fi
}

bashrc_block_remove() {
    local rc
    rc=$(bashrc_path)
    [ -n "$rc" ] || return 0
    [ -f "$rc" ] || return 0
    if ! bashrc_block_present; then
        return 0
    fi
    # Strip the block (begin marker, end marker, and any blank line
    # immediately preceding the block we added).
    sed -i.bak \
        -e "/^$(printf '%s' "$BASHRC_BEGIN_MARKER" | sed 's/[]\/$*.^[]/\\&/g')\$/,/^$(printf '%s' "$BASHRC_END_MARKER" | sed 's/[]\/$*.^[]/\\&/g')\$/d" \
        "$rc"
    rm -f "$rc.bak"
}

print_enabled_message() {
    echo "Greeting enabled. The current battery state will be shown at the top"
    echo "of every new interactive shell (terminal tabs, SSH, console)."
    if [ ! -e "$PROFILE_FILE" ]; then
        echo
        echo "Note: $PROFILE_FILE is missing. The package shipped it, but"
        echo "something has removed it. Reinstall the package to restore it."
    fi
}

write_flag_with_correct_ownership() {
    : > "$MOTD_FLAG"
    # When invoked under sudo, the file we just created may end up
    # root-owned and not writable by group members. Make sure the flag
    # is group-owned by inhibit-charge and group-writable so future
    # toggles by group members work without sudo.
    if [ "$(id -u)" -eq 0 ]; then
        chgrp inhibit-charge "$MOTD_FLAG" 2>/dev/null || true
        chmod 0664 "$MOTD_FLAG" 2>/dev/null || true
    fi
}

cmd_motd() {
    local sub=${1:-toggle}
    case "$sub" in
        on|enable)
            motd_require_writable
            write_flag_with_correct_ownership
            bashrc_block_add
            print_enabled_message
            ;;
        off|disable)
            motd_require_writable
            rm -f "$MOTD_FLAG"
            bashrc_block_remove
            echo "Greeting disabled."
            ;;
        status)
            if motd_enabled; then
                echo "Greeting: enabled (every new interactive shell)."
                if ! bashrc_block_present; then
                    echo "Note: ~/.bashrc does not currently source the greeting; new"
                    echo "non-login terminals will not show it. Run 'inhibit-charge motd"
                    echo "off' then 'inhibit-charge motd on' to add the source line."
                fi
            else
                echo "Greeting: disabled."
            fi
            ;;
        toggle|"")
            motd_require_writable
            if motd_enabled; then
                rm -f "$MOTD_FLAG"
                bashrc_block_remove
                echo "Greeting disabled."
            else
                write_flag_with_correct_ownership
                bashrc_block_add
                print_enabled_message
            fi
            ;;
        *)
            echo "Usage: inhibit-charge motd [on|off|status|toggle]" >&2
            exit 1
            ;;
    esac
}

# Compact one-liner used by /etc/profile.d/50-inhibit-charge.sh.
# Different from 'status' (which is a multi-line block for humans
# inspecting state). Reads the same sysfs and state files; no I/O cost
# beyond a few cat() calls. Hidden from the help output because it is
# meant for the MOTD pipeline.
cmd_motd_render() {
    detect_supplies
    local mode target capacity ac behaviour ac_str
    mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "?")
    target=$(cat "$STATE_DIR/target" 2>/dev/null || echo "?")
    capacity=$(cat "$BAT/capacity" 2>/dev/null || echo "?")
    ac=$(cat "$AC/online" 2>/dev/null || echo "0")
    if [ -r "$BAT/charge_behaviour" ]; then
        behaviour=$(grep -oP '\[\K[^\]]+' "$BAT/charge_behaviour" || echo "?")
    else
        behaviour="?"
    fi
    [ "$ac" = "1" ] && ac_str="plugged in" || ac_str="on battery"

    case "$mode" in
        home)
            if [ "$behaviour" = "inhibit-charge" ]; then
                printf "inhibit-charge: home mode, parked at %s%%, currently %s%% (%s).\n" \
                    "$target" "$capacity" "$ac_str"
            else
                printf "inhibit-charge: home mode, target %s%%, currently %s%% (%s, %s).\n" \
                    "$target" "$capacity" "$ac_str" "$behaviour"
            fi
            ;;
        travel)
            printf "inhibit-charge: travel mode (charge to 100%%), currently %s%% (%s).\n" \
                "$capacity" "$ac_str"
            ;;
        *)
            printf "inhibit-charge: %s mode, currently %s%% (%s).\n" \
                "$mode" "$capacity" "$ac_str"
            ;;
    esac
    # Trailing blank line keeps subsequent MOTD entries readable.
    echo
}

reload_daemon() {
    # Best-effort: tell the daemon to re-evaluate now. If the unit is not
    # active or the user lacks permission, fall back to the daemon's own
    # event/timer loop (next firing applies the change).
    systemctl reload-or-restart --no-block "$SERVICE" 2>/dev/null || \
        systemctl kill --signal=HUP "$SERVICE" 2>/dev/null || true
}

write_state() {
    local mode=$1 target=${2:-}
    if [ ! -w "$STATE_DIR/mode" ]; then
        echo "Error: $STATE_DIR/mode is not writable by your user." >&2
        if id -nG | tr ' ' '\n' | grep -qx inhibit-charge; then
            echo "(your user is in the inhibit-charge group but the state dir is not group-writable)" >&2
            echo "Try: sudo chmod 0664 $STATE_DIR/mode $STATE_DIR/target" >&2
        elif getent group inhibit-charge >/dev/null 2>&1; then
            echo "Your login session does not yet have the 'inhibit-charge' group active." >&2
            echo "You need a fresh shell session: a new terminal tab in the SAME login is" >&2
            echo "not enough (Linux freezes group lists at login). Pick one:" >&2
            echo "  newgrp inhibit-charge   (works in this terminal, no logout needed)" >&2
            echo "  log out and log back in" >&2
            echo "  reboot" >&2
            echo "If you have not been added to the group yet:" >&2
            echo "  sudo usermod -aG inhibit-charge \$USER" >&2
        else
            echo "The 'inhibit-charge' group does not exist yet. Add yourself with:" >&2
            echo "  sudo usermod -aG inhibit-charge \$USER" >&2
            echo "then run 'newgrp inhibit-charge' in this terminal or open a new one." >&2
        fi
        exit 1
    fi
    printf '%s\n' "$mode" > "$STATE_DIR/mode"
    if [ -n "$target" ]; then
        printf '%s\n' "$target" > "$STATE_DIR/target"
    fi
    reload_daemon
}

show_status() {
    detect_supplies
    local mode target capacity ac behaviour start end ac_str
    mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "(unset)")
    target=$(cat "$STATE_DIR/target" 2>/dev/null || echo "(unset)")
    capacity=$(cat "$BAT/capacity" 2>/dev/null || echo "?")
    ac=$(cat "$AC/online" 2>/dev/null || echo "0")
    if [ -r "$BAT/charge_behaviour" ]; then
        behaviour=$(grep -oP '\[\K[^\]]+' "$BAT/charge_behaviour" || echo "?")
    else
        behaviour="(not supported)"
    fi
    start=$(cat "$BAT/charge_control_start_threshold" 2>/dev/null || echo "?")
    end=$(cat "$BAT/charge_control_end_threshold" 2>/dev/null || echo "?")

    [ "$ac" = "1" ] && ac_str="plugged in" || ac_str="on battery"

    printf "Mode:       %s (target %s%%)\n" "$mode" "$target"
    printf "Battery:    %s%% (%s)\n" "$capacity" "$ac_str"
    printf "Behaviour:  %s\n" "$behaviour"
    printf "Thresholds: %s%% .. %s%%\n" "$start" "$end"
    printf "Supplies:   bat=%s ac=%s\n" "$BAT" "$AC"

    if [ "$behaviour" = "(not supported)" ] || [ "$behaviour" = "?" ]; then
        cat <<EOF

Note: this hardware does not expose the inhibit-charge interface, so
this tool cannot park your battery here. If you only need start/end
charge thresholds, use TLP instead. Run 'inhibit-charge check' for the
full diagnostic, or 'sudo apt purge inhibit-charge' to remove cleanly.
EOF
    fi
}

cmd_check() {
    local lib="$LIBDIR/compat-check.sh"
    if [ ! -r "$lib" ]; then
        echo "Error: $lib is missing. Reinstall the inhibit-charge package." >&2
        exit 2
    fi
    # shellcheck source=lib/inhibit-charge/compat-check.sh
    . "$lib"
    if check_compat; then
        echo "OK: this host can run inhibit-charge."
        echo "    Kernel and sysfs interface look fine. The daemon should park"
        echo "    your battery once you set a mode (see 'inhibit-charge home')."
        exit 0
    fi
    cat >&2 <<EOF

This host cannot run inhibit-charge. Recommended next step:

  Install TLP and configure start/end charge thresholds. TLP works on
  most laptops where inhibit-charge does not, because it only needs the
  threshold sysfs interface (not the inhibit-charge mode):
      sudo apt install tlp tlp-rdw
      sudo tlp start

  Then in /etc/tlp.conf set START_CHARGE_THRESH_BAT0 / STOP_CHARGE_THRESH_BAT0
  to your preferred range (e.g. 55 and 60). This will not hold the
  battery as flat as inhibit-charge would, but it is the best your
  hardware supports.

To remove inhibit-charge cleanly:
  sudo apt purge inhibit-charge

EOF
    exit 1
}

cmd=${1:-status}
case "$cmd" in
    home)
        target=${2:-60}
        if ! [[ "$target" =~ ^[0-9]+$ ]] || [ "$target" -lt 20 ] || [ "$target" -gt 95 ]; then
            echo "Error: TARGET must be 20..95" >&2
            exit 1
        fi
        write_state home "$target"
        echo "Switched to home mode (park at ${target}%)."
        ;;
    travel)
        write_state travel
        echo "Switched to travel mode (charge to 100%)."
        ;;
    toggle)
        cur=$(cat "$STATE_DIR/mode" 2>/dev/null || echo home)
        if [ "$cur" = "travel" ]; then
            write_state home
            echo "Toggled: travel -> home (park at $(cat "$STATE_DIR/target")%)."
        else
            write_state travel
            echo "Toggled: home -> travel (charge to 100%)."
        fi
        ;;
    status|"")
        show_status
        ;;
    check|compat)
        cmd_check
        ;;
    motd)
        shift || true
        cmd_motd "${1:-}"
        ;;
    motd-render)
        # Internal: invoked by /etc/profile.d/50-inhibit-charge.sh.
        cmd_motd_render
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
