#!/usr/bin/env bash
# inhibit-charge: switch laptop battery between "home" (park at target%) and
# "travel" (charge to 100). User-facing CLI for the inhibit-charge package.
set -euo pipefail

STATE_DIR=/var/lib/inhibit-charge
SERVICE=inhibit-charged.service

# Auto-detect the first BAT* and first AC-like supply. Falls back to BAT0/AC.
detect_supplies() {
    local d type
    BAT=""
    AC=""
    for d in /sys/class/power_supply/*; do
        [ -r "$d/type" ] || continue
        type=$(cat "$d/type" 2>/dev/null || echo "")
        case "$type" in
            Battery) [ -z "$BAT" ] && BAT=$d ;;
            Mains|USB|USB_PD|USB_PD_DRP|USB_C|ACAD) [ -z "$AC" ] && AC=$d ;;
        esac
    done
    [ -n "$BAT" ] || BAT=/sys/class/power_supply/BAT0
    [ -n "$AC" ]  || AC=/sys/class/power_supply/AC
}

usage() {
    cat <<EOF
Usage: inhibit-charge <command>

Commands:
  home [TARGET]    Park battery at TARGET% (default 60). Holds the battery
                   there indefinitely on AC using inhibit-charge.
  travel           Charge fully to 100% for unplugged use.
  toggle           Flip between home and travel.
  status           Show current mode, battery %, AC status, behaviour.
  motd [on|off]    Toggle the greeting shown at the top of every new
                   interactive shell. With no argument, toggle. With
                   "status", just report.

Examples:
  inhibit-charge home        # park at 60% (default)
  inhibit-charge home 70     # park at 70%
  inhibit-charge travel      # before going out
  inhibit-charge motd        # toggle terminal greeting on/off

DISCLAIMER: This tool writes to your laptop's battery management
interface. It is provided AS IS, WITHOUT WARRANTY OF ANY KIND. You are
solely responsible for any damage to your battery, hardware, or data.
The author is not liable for damage caused by events outside their
control (supply-chain compromise, modifications made downstream, etc).
See /usr/share/doc/inhibit-charge/README.md for the full disclaimer.
EOF
}

# The greeting is implemented via /etc/profile.d/50-inhibit-charge.sh,
# which is always sourced by every interactive shell on Debian/Ubuntu,
# but short-circuits unless this flag file exists. So the toggle is just
# a flag file under the state dir, owned by root:inhibit-charge so the
# CLI itself can flip it without sudo when run by a group member.
MOTD_FLAG=/var/lib/inhibit-charge/motd-enabled
PROFILE_FILE=/etc/profile.d/50-inhibit-charge.sh

motd_enabled() {
    [ -f "$MOTD_FLAG" ]
}

motd_require_writable() {
    if [ "$(id -u)" -eq 0 ]; then
        return 0
    fi
    # Group members can write the flag file because the state dir is
    # group-writable. No sudo needed in that case.
    if [ -w "$STATE_DIR" ]; then
        return 0
    fi
    echo "Error: cannot write to $STATE_DIR." >&2
    echo "Either: run with sudo, or add yourself to the inhibit-charge group" >&2
    echo "and start a fresh shell session (newgrp inhibit-charge)." >&2
    exit 1
}

print_enabled_message() {
    echo "Greeting enabled. The current battery state will be shown at the top"
    echo "of every new interactive shell (terminal tabs, SSH, console)."
    if [ ! -e "$PROFILE_FILE" ]; then
        echo
        echo "Note: $PROFILE_FILE is missing. The package shipped it, but"
        echo "something has removed it. Reinstall the package to restore it."
    fi
}

cmd_motd() {
    local sub=${1:-toggle}
    case "$sub" in
        on|enable)
            motd_require_writable
            : > "$MOTD_FLAG"
            print_enabled_message
            ;;
        off|disable)
            motd_require_writable
            rm -f "$MOTD_FLAG"
            echo "Greeting disabled."
            ;;
        status)
            if motd_enabled; then
                echo "Greeting: enabled (every new interactive shell)."
            else
                echo "Greeting: disabled."
            fi
            ;;
        toggle|"")
            motd_require_writable
            if motd_enabled; then
                rm -f "$MOTD_FLAG"
                echo "Greeting disabled."
            else
                : > "$MOTD_FLAG"
                print_enabled_message
            fi
            ;;
        *)
            echo "Usage: inhibit-charge motd [on|off|status|toggle]" >&2
            exit 1
            ;;
    esac
}

# Compact one-liner used by /etc/profile.d/50-inhibit-charge.sh.
# Different from 'status' (which is a multi-line block for humans
# inspecting state). Reads the same sysfs and state files; no I/O cost
# beyond a few cat() calls. Hidden from the help output because it is
# meant for the MOTD pipeline.
cmd_motd_render() {
    detect_supplies
    local mode target capacity ac behaviour ac_str
    mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "?")
    target=$(cat "$STATE_DIR/target" 2>/dev/null || echo "?")
    capacity=$(cat "$BAT/capacity" 2>/dev/null || echo "?")
    ac=$(cat "$AC/online" 2>/dev/null || echo "0")
    if [ -r "$BAT/charge_behaviour" ]; then
        behaviour=$(grep -oP '\[\K[^\]]+' "$BAT/charge_behaviour" || echo "?")
    else
        behaviour="?"
    fi
    [ "$ac" = "1" ] && ac_str="plugged in" || ac_str="on battery"

    case "$mode" in
        home)
            if [ "$behaviour" = "inhibit-charge" ]; then
                printf "inhibit-charge: home mode, parked at %s%%, currently %s%% (%s).\n" \
                    "$target" "$capacity" "$ac_str"
            else
                printf "inhibit-charge: home mode, target %s%%, currently %s%% (%s, %s).\n" \
                    "$target" "$capacity" "$ac_str" "$behaviour"
            fi
            ;;
        travel)
            printf "inhibit-charge: travel mode (charge to 100%%), currently %s%% (%s).\n" \
                "$capacity" "$ac_str"
            ;;
        *)
            printf "inhibit-charge: %s mode, currently %s%% (%s).\n" \
                "$mode" "$capacity" "$ac_str"
            ;;
    esac
    # Trailing blank line keeps subsequent MOTD entries readable.
    echo
}

reload_daemon() {
    # Best-effort: tell the daemon to re-evaluate now. If the unit is not
    # active or the user lacks permission, fall back to the daemon's own
    # event/timer loop (next firing applies the change).
    systemctl reload-or-restart --no-block "$SERVICE" 2>/dev/null || \
        systemctl kill --signal=HUP "$SERVICE" 2>/dev/null || true
}

write_state() {
    local mode=$1 target=${2:-}
    if [ ! -w "$STATE_DIR/mode" ]; then
        echo "Error: $STATE_DIR/mode is not writable by your user." >&2
        if id -nG | tr ' ' '\n' | grep -qx inhibit-charge; then
            echo "(your user is in the inhibit-charge group but the state dir is not group-writable)" >&2
            echo "Try: sudo chmod 0664 $STATE_DIR/mode $STATE_DIR/target" >&2
        elif getent group inhibit-charge >/dev/null 2>&1; then
            echo "Your login session does not yet have the 'inhibit-charge' group active." >&2
            echo "You need a fresh shell session: a new terminal tab in the SAME login is" >&2
            echo "not enough (Linux freezes group lists at login). Pick one:" >&2
            echo "  newgrp inhibit-charge   (works in this terminal, no logout needed)" >&2
            echo "  log out and log back in" >&2
            echo "  reboot" >&2
            echo "If you have not been added to the group yet:" >&2
            echo "  sudo usermod -aG inhibit-charge \$USER" >&2
        else
            echo "The 'inhibit-charge' group does not exist yet. Add yourself with:" >&2
            echo "  sudo usermod -aG inhibit-charge \$USER" >&2
            echo "then run 'newgrp inhibit-charge' in this terminal or open a new one." >&2
        fi
        exit 1
    fi
    printf '%s\n' "$mode" > "$STATE_DIR/mode"
    if [ -n "$target" ]; then
        printf '%s\n' "$target" > "$STATE_DIR/target"
    fi
    reload_daemon
}

show_status() {
    detect_supplies
    local mode target capacity ac behaviour start end ac_str
    mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "(unset)")
    target=$(cat "$STATE_DIR/target" 2>/dev/null || echo "(unset)")
    capacity=$(cat "$BAT/capacity" 2>/dev/null || echo "?")
    ac=$(cat "$AC/online" 2>/dev/null || echo "0")
    if [ -r "$BAT/charge_behaviour" ]; then
        behaviour=$(grep -oP '\[\K[^\]]+' "$BAT/charge_behaviour" || echo "?")
    else
        behaviour="(not supported)"
    fi
    start=$(cat "$BAT/charge_control_start_threshold" 2>/dev/null || echo "?")
    end=$(cat "$BAT/charge_control_end_threshold" 2>/dev/null || echo "?")

    [ "$ac" = "1" ] && ac_str="plugged in" || ac_str="on battery"

    printf "Mode:       %s (target %s%%)\n" "$mode" "$target"
    printf "Battery:    %s%% (%s)\n" "$capacity" "$ac_str"
    printf "Behaviour:  %s\n" "$behaviour"
    printf "Thresholds: %s%% .. %s%%\n" "$start" "$end"
    printf "Supplies:   bat=%s ac=%s\n" "$BAT" "$AC"
}

cmd=${1:-status}
case "$cmd" in
    home)
        target=${2:-60}
        if ! [[ "$target" =~ ^[0-9]+$ ]] || [ "$target" -lt 20 ] || [ "$target" -gt 95 ]; then
            echo "Error: TARGET must be 20..95" >&2
            exit 1
        fi
        write_state home "$target"
        echo "Switched to home mode (park at ${target}%)."
        ;;
    travel)
        write_state travel
        echo "Switched to travel mode (charge to 100%)."
        ;;
    toggle)
        cur=$(cat "$STATE_DIR/mode" 2>/dev/null || echo home)
        if [ "$cur" = "travel" ]; then
            write_state home
            echo "Toggled: travel -> home (park at $(cat "$STATE_DIR/target")%)."
        else
            write_state travel
            echo "Toggled: home -> travel (charge to 100%)."
        fi
        ;;
    status|"")
        show_status
        ;;
    motd)
        shift || true
        cmd_motd "${1:-}"
        ;;
    motd-render)
        # Internal: invoked by /etc/profile.d/50-inhibit-charge.sh.
        cmd_motd_render
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
