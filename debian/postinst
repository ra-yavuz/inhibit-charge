#!/bin/sh
# postinst for inhibit-charge
set -e

GROUP=inhibit-charge
STATE_DIR=/var/lib/inhibit-charge

case "$1" in
    configure)
        # Run the shared compatibility check the daemon will use. We do
        # NOT fail the postinst on incompatible hardware: a non-zero exit
        # leaves the package half-configured and breaks future apt
        # operations. Instead, warn loudly and skip the enable/start
        # step so the daemon does not flap on an unsupported host. The
        # admin can purge the package cleanly with apt purge.
        COMPAT_LIB=/usr/lib/inhibit-charge/compat-check.sh
        COMPAT_OK=1
        if [ -r "$COMPAT_LIB" ]; then
            # shellcheck source=lib/inhibit-charge/compat-check.sh
            if ! . "$COMPAT_LIB" || ! check_compat; then
                COMPAT_OK=0
            fi
        fi
        if [ "$COMPAT_OK" = "0" ]; then
            cat >&2 <<'EOF'

================================================================
  inhibit-charge: this host does not look compatible
================================================================
  The package was installed, but the daemon will NOT be enabled
  or started, because the compatibility check above did not pass.

  See /usr/share/doc/inhibit-charge/README.md for hardware support.
  If you only need start/end thresholds, use TLP instead.

  To remove cleanly:   sudo apt purge inhibit-charge
================================================================

EOF
        fi

        # Migrate from <0.4.0: drop the old PAM-MOTD entry if it exists.
        # 0.4.0 ships /etc/profile.d/50-inhibit-charge.sh instead.
        if [ -e /etc/update-motd.d/50-inhibit-charge ]; then
            rm -f /etc/update-motd.d/50-inhibit-charge
        fi

        # Fix ownership of the motd-enabled flag if 0.4.0 created it
        # with the wrong group/mode. 0.4.1 onward chgrp + chmod itself
        # but the existing flag file from a previous toggle would still
        # be root:root 0644.
        if [ -f /var/lib/inhibit-charge/motd-enabled ]; then
            chgrp inhibit-charge /var/lib/inhibit-charge/motd-enabled 2>/dev/null || true
            chmod 0664           /var/lib/inhibit-charge/motd-enabled 2>/dev/null || true
        fi

        # Create the inhibit-charge group if missing. Members of this group
        # can write to the state files via the group-writable permission
        # below; no sudo is needed for the CLI.
        if ! getent group "$GROUP" >/dev/null; then
            addgroup --system "$GROUP"
        fi

        install -d -o root -g "$GROUP" -m 0775 "$STATE_DIR"
        for f in mode target; do
            if [ ! -e "$STATE_DIR/$f" ]; then
                case "$f" in
                    mode)   echo home > "$STATE_DIR/$f" ;;
                    target) echo 60   > "$STATE_DIR/$f" ;;
                esac
            fi
            chown root:"$GROUP" "$STATE_DIR/$f"
            chmod 0664 "$STATE_DIR/$f"
        done

        # Enable and start the daemon. We do this in postinst because the
        # script-built .deb does not run dh_installsystemd, which would
        # normally handle this for us. Re-running on upgrades is a no-op.
        # Skip entirely on incompatible hardware: starting a daemon that
        # will exit immediately just spams the journal.
        if [ -d /run/systemd/system ] && [ "$COMPAT_OK" = "1" ]; then
            systemctl daemon-reload || true
            systemctl enable inhibit-charged.service || true
            # On fresh install, start it. On upgrade, restart so the new
            # binary is picked up. `try-restart` is the safer of the two
            # for upgrades (it won't start a unit the admin had stopped).
            if [ -z "${2:-}" ]; then
                systemctl start inhibit-charged.service || true
            else
                systemctl try-restart inhibit-charged.service || true
            fi
        elif [ -d /run/systemd/system ] && [ "$COMPAT_OK" = "0" ]; then
            # Belt and braces: if a previous compatible install enabled
            # the unit and a later kernel/hardware change made it
            # incompatible, leave the unit disabled rather than letting
            # systemd thrash on Restart=on-failure.
            systemctl disable inhibit-charged.service 2>/dev/null || true
            systemctl stop inhibit-charged.service 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
